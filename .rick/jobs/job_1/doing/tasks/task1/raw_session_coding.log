            with open(skill_md, \"r\", encoding=\"utf-8\") as f:\n58\t                content = f.read()\n59\t        except Exception as e:\n60\t            errors.append(f\"无法读取 SKILL.md: {str(e)}\")\n61\t            content = \"\"\n62\t\n63\t        # ============================================================\n64\t        # Test 3: Frontmatter 元数据\n65\t        # 前置条件：SKILL.md 存在且可读\n66\t        # 输入参数：文件内容\n67\t        # 操作序列：检查 YAML frontmatter 是否包含 name 和 description\n68\t        # 预期输出：包含 name: okf-knowledge-read 和 description\n69\t        # ============================================================\n70\t        if not content.startswith(\"---\"):\n71\t            errors.append(\n72\t                \"SKILL.md 缺少 YAML frontmatter（应以 '---' 开头）\"\n73\t            )\n74\t        else:\n75\t            # 提取 frontmatter\n76\t            second_delim = content.find(\"---\", 3)\n77\t            if second_delim == -1:\n78\t                errors.append(\n79\t                    \"SKILL.md frontmatter 格式错误：缺少结束的 '---'\"\n80\t                )\n81\t            else:\n82\t                frontmatter = content[3:second_delim].strip()\n83\t                fm_lines = [line.strip() for line in frontmatter.split(\"\\n\")]\n84\t\n85\t                has_name = any(\n86\t                    line.startswith(\"name:\") and \"okf-knowledge-read\" in line\n87\t                    for line in fm_lines\n88\t                )\n89\t                if not has_name:\n90\t                    errors.append(\n91\t                        \"SKILL.md frontmatter 缺少 name: okf-knowledge-read\"\n92\t                    )\n93\t\n94\t                has_description = any(\n95\t                    line.startswith(\"description:\") for line in fm_lines\n96\t                )\n97\t                if not has_description:\n98\t                    errors.append(\n99\t                        \"SKILL.md frontmatter 缺少 description\"\n100\t                    )\n101\t\n102\t        # ====================