3\t        # Test 7: 核心 5 步 Pipeline 指令\n154\t        # 前置条件：SKILL.md 存在且可读\n155\t        # 输入参数：文件内容\n156\t        # 操作序列：检查 5 个 Pipeline 步骤\n157\t        # 预期输出：\n158\t        #   1. 发现知识库\n159\t        #   2. 匹配概念\n160\t        #   3. 加载文档\n161\t        #   4. 追踪链接\n162\t        #   5. 注入上下文\n163\t        # ============================================================\n164\t        pipeline_steps = [\n165\t            (\"发现知识库\", [\"发现知识库\", \"Discover\"]),\n166\t            (\"匹配概念\", [\"匹配概念\", \"Match\"]),\n167\t            (\"加载文档\", [\"加载文档\", \"Load\"]),\n168\t            (\"追踪链接\", [\"追踪链接\", \"Trace\"]),\n169\t            (\"注入上下文\", [\"注入上下文\", \"Inject\"]),\n170\t        ]\n171\t\n172\t        missing_steps = []\n173\t        for step_name, keywords in pipeline_steps:\n174\t            found = any(kw in content for kw in keywords)\n175\t            if not found:\n176\t                missing_steps.append(step_name)\n177\t\n178\t        if missing_steps:\n179\t            errors.append(\n180\t                f\"SKILL.md 缺少以下 Pipeline 步骤: {', '.join(missing_steps)}\"\n181\t                f\"（需要: 发现知识库 → 匹配概念 → 加载文档 → 追踪链接 → 注入上下文）\"\n182\t            )\n183\t\n184\t        # ============================================================\n185\t        # Test 8: 边界用例处理 —— 缺少 type-registry.md\n186\t        # 前置条件：SKILL.md 存在且可读\n187\t        # 输入参数：文件内容\n188\t        # 操作序列：检查是否说明 type-registry.md 缺失时的回退策略\n189\t        # 预期输出：文档提到回退到内置 Type 定义\n190\t        # ============================================================\n191\t        has_type_fallback = (\n192\t            \"type-registry\" in content\n193\t            or \"type_registry\" in content\n194\t            or \"type registry\" in content.lower()\n195\t            or \"内置\" in content\n196\t        )\n197\t        if not has_type_fallback:\n198\t            errors.append(\n199\t                \"SKILL.md 缺少 type-registry 相关说明（需包含缺失时的回退策略）\"\n200\t            )\n201\t\n202\t        # ================